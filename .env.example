# Copy to .env locally. Do not commit real values.

# MongoDB (required)
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?appName=insaf
MONGODB_DB=insaf_gas_corp

# Session (required in production, minimum 32 characters)
SESSION_SECRET=replace-with-a-long-random-secret-32chars

# Optional bootstrap login if appUsers is empty. Set both or neither.
# AUTH_USER=
# AUTH_PASSWORD=
# AUTH_DISPLAY_NAME=

# Demo quick-login. Never set this in production.
# DEMO_LOGIN=true
